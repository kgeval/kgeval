      "embedding_dimensions": {
        "embedding": 2
      }
    },
    {
      "id": "4:f55f160f-fe22-4227-97fd-5c7f875fb3b4:14",
      "labels": [
        "Chunk"
      ],
      "properties": {
        "text": "Raffles founded modern Singapore in 1819. Lee Kuan Yew became its first prime minister in 1959."
      },
